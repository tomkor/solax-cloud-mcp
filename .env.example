# SolaX Developer Platform OAuth2 client ID (required)
# Register an OAuth2 application at https://developer.solaxcloud.com/
# and obtain from the Application page
SOLAX_CLIENT_ID=

# SolaX Developer Platform OAuth2 client secret (required)
# Register an OAuth2 application at https://developer.solaxcloud.com/
# and obtain from the Application page
SOLAX_CLIENT_SECRET=

# Device (inverter) serial number (optional)
# The inverter's SN, NOT the old WiFi dongle registration number
# If set, this device will be queried by default when get_realtime_data is called with no device_sn
# If not set, device_sn must be passed to each tool call
SOLAX_DEVICE_SN=

# Expose the inverter-control MCP tool (set_battery_self_use_mode) to the LLM (optional)
# Disabled by default: with it enabled, an LLM (e.g. via prompt injection) can change inverter settings.
# Does not affect the HTTP API, which is protected by HTTP_API_KEY.
# SOLAX_ALLOW_WRITE=1

# Solcast PV forecast (optional) - enables get_solar_forecast tool and /api/solar-forecast
# Free hobbyist account: https://toolkit.solcast.com.au/ (add rooftop site, copy API key and Resource ID)
# SOLCAST_API_KEY=
# Comma-separated rooftop site Resource IDs (e.g. east and west arrays)
# SOLCAST_RESOURCE_IDS=
# Cache TTL in minutes; hobbyist accounts allow ~10 calls/day, each refresh = 1 call per site
# SOLCAST_CACHE_MINUTES=180
# IANA timezone for forecast day boundaries and timestamps (default: UTC)
# SOLAR_TIMEZONE=Europe/Warsaw

# Battery automation (optional, HTTP server only) - forecast-driven grid charging for G12w-like tariffs
# Before each off-peak window, charge from grid only as much as the following peak hours need
# (consumption - Solcast PV forecast). Requires SOLCAST_* and SOLAX_DEVICE_SN.
# AUTOMATION_ENABLED=1
# Log decisions only; set to 0 to actually write settings to the inverter (default: 1)
# AUTOMATION_DRY_RUN=1
# BATTERY_CAPACITY_KWH=21.2
# Average daily household consumption (flat profile), or 24 hourly kWh values (local hours 0..23)
# AUTOMATION_DAILY_CONSUMPTION_KWH=12
# AUTOMATION_CONSUMPTION_PROFILE=0.3,0.3,0.3,0.3,0.3,0.3,0.5,0.5,0.5,0.5,0.5,1.2,1.2,1.2,1.2,1.2,1.2,0.6,0.6,0.6,0.6,0.6,0.25,0.25
# Weekends and public holidays (optional, defaults to the weekday profile)
# AUTOMATION_WEEKEND_DAILY_CONSUMPTION_KWH=19
# AUTOMATION_WEEKEND_CONSUMPTION_PROFILE=0.3,0.3,0.3,0.3,0.3,0.3,0.5,0.5,0.5,0.5,0.5,1.9,1.9,1.9,1.9,1.9,1.9,0.6,0.6,0.6,0.6,0.6,0.25,0.25
# Battery reserve (never discharged below) and upper limit for grid charging (%)
# AUTOMATION_MIN_SOC=15
# AUTOMATION_MAX_GRID_SOC=100
# AUTOMATION_SAFETY_MARGIN_KWH=1.0
# AUTOMATION_EFFICIENCY=0.9
# Forecast scenario: p10 (pessimistic, charges more), p50 (most likely), p90 (optimistic)
# AUTOMATION_FORECAST_PERCENTILE=p50
# Planner runs this many minutes before each off-peak window
# AUTOMATION_LEAD_MINUTES=10
# Off-peak windows (full hours), weekends and Polish public holidays off-peak (G12w defaults)
# Winter (1 Oct - 31 Mar), or all year if no summer windows are set
# TARIFF_OFFPEAK_WINDOWS=22:00-06:00,13:00-15:00
# Summer (1 Apr - 30 Sep); defaults to the G12w summer hours, or to TARIFF_OFFPEAK_WINDOWS if that is set
# TARIFF_OFFPEAK_WINDOWS_SUMMER=22:00-06:00,15:00-17:00
# TARIFF_OFFPEAK_WEEKENDS=1
# TARIFF_OFFPEAK_HOLIDAYS=1

# Battery export planner (optional, requires AUTOMATION_ENABLED=1)
# Sells battery surplus (above what the house needs until the next off-peak window) in the most
# expensive 15-min RCE slots (PSE market prices), via SolaX remote control (soc_target_control_mode).
# EXPORT_ENABLED=1
# Log decisions only; set to 0 to actually send export commands to the inverter (default: 1)
# EXPORT_DRY_RUN=1
# EXPORT_MIN_PRICE_PLN_KWH=1.0
# EXPORT_MAX_POWER_KW=8
# EXPORT_MIN_SLOT_KWH=0.2
# Multiplier applied to RCE before comparing with the threshold (e.g. 1.23 if your deposit uses it)
# EXPORT_PRICE_MULTIPLIER=1.0

# HTTP Server Configuration (only used when TRANSPORT=http)
# ============================================================

# Bearer token for HTTP API authentication (required for HTTP mode)
# Generate a strong random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
HTTP_API_KEY=

# HTTP server host when run directly (optional, default: 127.0.0.1)
# The Docker image sets 0.0.0.0 internally; use HTTP_BIND_ADDR to control host exposure.
HTTP_HOST=127.0.0.1

# docker-compose: host address the port is published on (optional, default: 127.0.0.1)
# Set to the Pi's LAN IP to allow access from other machines.
# HTTP_BIND_ADDR=192.168.1.10

# HTTP server port (optional, default: 8000)
HTTP_PORT=8000

# Transport mode: "stdio" for MCP (default) or "http" for HTTP server
# TRANSPORT=http
