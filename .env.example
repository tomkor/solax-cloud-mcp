# SolaX Developer Platform OAuth2 client ID (required)
# Register an OAuth2 application at https://developer.solaxcloud.com/
# and obtain from the Application page
SOLAX_CLIENT_ID=

# SolaX Developer Platform OAuth2 client secret (required)
# Register an OAuth2 application at https://developer.solaxcloud.com/
# and obtain from the Application page
SOLAX_CLIENT_SECRET=

# Device (inverter) serial number (optional)
# The inverter's SN, NOT the old WiFi dongle registration number
# If set, this device will be queried by default when get_realtime_data is called with no device_sn
# If not set, device_sn must be passed to each tool call
SOLAX_DEVICE_SN=

# Expose the inverter-control MCP tool (set_battery_self_use_mode) to the LLM (optional)
# Disabled by default: with it enabled, an LLM (e.g. via prompt injection) can change inverter settings.
# Does not affect the HTTP API, which is protected by HTTP_API_KEY.
# SOLAX_ALLOW_WRITE=1

# Solcast PV forecast (optional) - enables get_solar_forecast tool and /api/solar-forecast
# Free hobbyist account: https://toolkit.solcast.com.au/ (add rooftop site, copy API key and Resource ID)
# SOLCAST_API_KEY=
# Comma-separated rooftop site Resource IDs (e.g. east and west arrays)
# SOLCAST_RESOURCE_IDS=
# Cache TTL in minutes; hobbyist accounts allow ~10 calls/day, each refresh = 1 call per site
# SOLCAST_CACHE_MINUTES=180
# IANA timezone for forecast day boundaries and timestamps (default: UTC)
# SOLAR_TIMEZONE=Europe/Warsaw

# HTTP Server Configuration (only used when TRANSPORT=http)
# ============================================================

# Bearer token for HTTP API authentication (required for HTTP mode)
# Generate a strong random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
HTTP_API_KEY=

# HTTP server host when run directly (optional, default: 127.0.0.1)
# The Docker image sets 0.0.0.0 internally; use HTTP_BIND_ADDR to control host exposure.
HTTP_HOST=127.0.0.1

# docker-compose: host address the port is published on (optional, default: 127.0.0.1)
# Set to the Pi's LAN IP to allow access from other machines.
# HTTP_BIND_ADDR=192.168.1.10

# HTTP server port (optional, default: 8000)
HTTP_PORT=8000

# Transport mode: "stdio" for MCP (default) or "http" for HTTP server
# TRANSPORT=http
